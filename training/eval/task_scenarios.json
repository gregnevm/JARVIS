[
  {"id": "health-tools", "category": "health",
   "request": {"service": "tools", "method": "GET", "path": "/health"},
   "expect": [{"type": "status", "code": 200}]},
  {"id": "health-gateway", "category": "health",
   "request": {"service": "gateway", "method": "GET", "path": "/health"},
   "expect": [{"type": "status", "code": 200}]},
  {"id": "health-memory", "category": "health",
   "request": {"service": "memory", "method": "GET", "path": "/health"},
   "expect": [{"type": "status", "code": 200}]},
  {"id": "health-twin", "category": "health",
   "request": {"service": "twin", "method": "GET", "path": "/health"},
   "expect": [{"type": "status", "code": 200}]},
  {"id": "tools-status", "category": "health",
   "request": {"service": "tools", "method": "GET", "path": "/status"},
   "expect": [{"type": "status", "code": 200}]},

  {"id": "calc-basic", "category": "tools",
   "request": {"service": "tools", "method": "POST", "path": "/calc", "json": {"expression": "17*23"}},
   "expect": [{"type": "status", "code": 200},
              {"type": "contains_any", "field": "result", "any": ["391"]}]},
  {"id": "calc-error-contract", "category": "tools",
   "request": {"service": "tools", "method": "POST", "path": "/calc", "json": {"expression": "2+"}},
   "expect": [{"type": "contains_any", "field": "result", "any": ["Помилка обчислення"]}]},
  {"id": "calc-length-guard", "category": "tools",
   "request": {"service": "tools", "method": "POST", "path": "/calc",
               "json": {"expression": ""}},
   "expect": [{"type": "contains_any", "field": "result", "any": ["Завеликий вираз"]}]},
  {"id": "dispatch-calc", "category": "tools",
   "request": {"service": "tools", "method": "POST", "path": "/tool/dispatch",
               "json": {"name": "calc", "arguments": {"expression": "6*7"}, "user_id": 0}},
   "expect": [{"type": "contains_any", "field": "text", "any": ["42"]}]},
  {"id": "parse-file-missing-contract", "category": "tools",
   "request": {"service": "tools", "method": "POST", "path": "/parse_file",
               "json": {"path": "/nonexistent/task_success_probe.txt"}},
   "expect": [{"type": "contains_any", "field": "text", "any": ["Файл не знайдено"]}]},

  {"id": "code-exec-contract", "category": "security",
   "request": {"service": "tools", "method": "POST", "path": "/code_exec", "json": {"code": "print(2+2)"}},
   "expect": [{"type": "contains_any", "field": "result",
               "any": ["4", "вимкнено", "Пісочниця недоступна"]}]},
  {"id": "code-exec-guard-env", "category": "security",
   "request": {"service": "tools", "method": "POST", "path": "/code_exec",
               "json": {"code": "import os; print(os.environ)"}},
   "expect": [{"type": "contains_any", "field": "result",
               "any": ["відхилено guard-правилом", "вимкнено"]}]},
  {"id": "code-exec-guard-spawn", "category": "security",
   "request": {"service": "tools", "method": "POST", "path": "/code_exec",
               "json": {"code": "import subprocess; subprocess.run(['id'])"}},
   "expect": [{"type": "contains_any", "field": "result",
               "any": ["відхилено guard-правилом", "вимкнено"]}]},

  {"id": "authority-policy-visible", "category": "authority",
   "request": {"service": "tools", "method": "GET", "path": "/computer/powershell/policy"},
   "expect": [{"type": "status", "code": 200},
              {"type": "json_key", "key": "approval_policy"},
              {"type": "json_key", "key": "require_confirm"}]},
  {"id": "authority-trust-status", "category": "authority",
   "request": {"service": "tools", "method": "GET", "path": "/computer/trust/status"},
   "expect": [{"type": "status", "code": 200}]},
  {"id": "authority-audit-surface", "category": "authority",
   "request": {"service": "tools", "method": "GET", "path": "/computer/audit"},
   "expect": [{"type": "status", "code": 200}]},
  {"id": "authority-learned-surface", "category": "authority",
   "request": {"service": "tools", "method": "GET", "path": "/computer/learned"},
   "expect": [{"type": "status", "code": 200}]},

  {"id": "ops-plans", "category": "ops",
   "request": {"service": "tools", "method": "GET", "path": "/agent/plans"},
   "expect": [{"type": "status", "code": 200}]},
  {"id": "ops-dataset-stats", "category": "ops",
   "request": {"service": "tools", "method": "GET", "path": "/dataset/stats"},
   "expect": [{"type": "status", "code": 200}]},
  {"id": "ops-jobs", "category": "ops",
   "request": {"service": "tools", "method": "GET", "path": "/jobs"},
   "expect": [{"type": "status", "code": 200}]},
  {"id": "ops-routines", "category": "ops",
   "request": {"service": "tools", "method": "GET", "path": "/routines/list"},
   "expect": [{"type": "status", "code": 200}]},
  {"id": "ops-macros", "category": "ops",
   "request": {"service": "tools", "method": "GET", "path": "/computer/macros"},
   "expect": [{"type": "status", "code": 200}]}
]
