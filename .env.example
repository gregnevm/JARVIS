# ============================================================
#  JARVIS — приклад конфігурації.
#  Автономно:  copy setup.local.env.example setup.local.env  →  FirstSetup-Auto.bat
#  Інтерактивно:  scripts\FirstSetup.ps1  або  FirstSetup.bat
#  Вручну:  cp .env.example .env   (Win: copy .env.example .env)
#  НІКОЛИ не коміть .env у git (він уже в .gitignore).
#  FirstSetup підбирає моделі під CPU/NVIDIA/AMD (data/hardware_profile.json).
# ============================================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Базовий whitelist (твій ID + необовʼязково інші). Решту погоджуй через бота: /allow.
ALLOWED_USER_IDS=123456789
# Адміни: /admin, /allow, /pending. Порожньо = усі з whitelist (.env + погоджені).
ADMIN_USER_IDS=123456789
# Файл друзів, погоджених через /allow (том ./data у Docker).
# ACCESS_STORE_PATH=/data/access/users.json
# Спосіб отримання апдейтів від Telegram:
#   polling — gateway сам опитує Telegram (getUpdates). Нуль інфраструктури,
#             переживає рестарти, НЕ треба публічний URL/тунель. Дефолт.
#   webhook — Telegram шле POST /webhook (потрібен стабільний публічний HTTPS:
#             named tunnel / домен + reverse proxy). Лише для прода.
TELEGRAM_INGEST_MODE=polling
# Секрет вебхука (лише для webhook-режиму): захист /webhook від підробок.
# Згенеруй: python -c "import secrets;print(secrets.token_hex(24))". Порожньо = вимкнено.
TELEGRAM_WEBHOOK_SECRET=
# Повний URL webhook (лише TELEGRAM_INGEST_MODE=webhook). Gateway викличе setWebhook на старті.
TELEGRAM_WEBHOOK_URL=
# Постійна Reply Keyboard під полем вводу (Статус, Бриф, Нагадування…).
TELEGRAM_REPLY_KEYBOARD=true

# --- Ollama (працює на ХОСТІ, не в контейнері) ---
# Контейнери звертаються до хоста через host.docker.internal.
OLLAMA_HOST=http://host.docker.internal:11434
# Дві моделі: легка для чату + сильніша для агент-лупа / tool calling.
# !!! БЕЗ GPU (CPU-інференс ~7-8 tok/s) уникай thinking-моделей (qwen3 та ін.):
#     вони "думають" сотні токенів і відповідь триває хвилини. Для CPU постав
#     non-thinking instruct, напр.: OLLAMA_MODEL_CHAT=qwen2.5:3b-instruct
OLLAMA_MODEL_CHAT=gemma3:4b
OLLAMA_MODEL_AGENT=qwen2.5:7b-instruct
# Vision-модель для розпізнавання зображень (фото/скріни). Порожньо = describe_image вимкнено.
# Напр.: OLLAMA_MODEL_VISION=llava:7b  або  qwen2.5vl:7b
OLLAMA_MODEL_VISION=
# C6.1: вивантажити chat+agent перед vision (тісна VRAM на 8 ГБ). Потребує OLLAMA_MODEL_VISION.
OLLAMA_VISION_ON_DEMAND=false
# Генерація зображень (опційно):
# Локально (рекомендовано): Forge API на хості
#   setup_sd_forge.ps1 → start_sd_forge.ps1 → IMAGE_GEN_URL нижче
IMAGE_GEN_URL=http://host.docker.internal:7860
IMAGE_GEN_MODEL=
IMAGE_GEN_TIMEOUT=300
# Хмара — лише явний opt-in (не дефолт): IMAGE_GEN_URL=horde | pollinations
# HORDE_API_KEY=0000000000   # краще власний ключ з aihorde.net
# Режим роутингу моделей: hybrid | chat | agent | computer
AGENT_MODE=hybrid
# Модель ембедингів. 768 вимірів → синхронізовано з vector(768) у db/init.sql!
# Зміниш модель з іншою розмірністю — треба міграція таблиці embeddings (Alembic schema_meta).
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
# Таймаути (сек) — підніми на CPU або довгих тул-лупах. Gateway: AGENT_TIMEOUT.
OLLAMA_TIMEOUT=180
MAX_AGENT_ITERS=5
FETCH_MAX_CHARS=6000
HTTP_TIMEOUT=20
COMPUTER_TIMEOUT=30
AGENT_TIMEOUT=300

# --- Whisper (STT) ---
WHISPER_MODEL=small
# Мова розпізнавання: порожньо = автовизначення (рекомендовано для змішаних мов).
# Можна форсувати, напр.: WHISPER_LANGUAGE=uk
WHISPER_LANGUAGE=

# --- PostgreSQL (+pgvector) ---
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jarvis
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Ліміти / фіче-прапори ---
RATE_LIMIT_PER_MIN=20
# Ліміт для погоджених друзів (не-адмінів). 0 = як RATE_LIMIT_PER_MIN.
GUEST_RATE_LIMIT_PER_MIN=12
# Виконання Python-коду в Tools. Вмикай свідомо (sandbox subprocess + timeout).
ENABLE_CODE_EXEC=false
# Computer Use — керування Windows-хостом (PowerShell/CLI/FS через host-agent на хості).
ENABLE_COMPUTER_USE=false
# Профіль tier: safe (T0/T1) | standard (+browser, UIA, see_screen) | full (+screen_click).
COMPUTER_PROFILE=safe
# Після ✅ — session trust без confirm для T0/T1 (хв; 0=вимк). Кнопка «Full trust» = усі tier.
COMPUTER_SESSION_TRUST_MINUTES=10
# Хто може керувати ЦИМ ПК (скріншот, PS, FS). Тільки ці Telegram ID — не друзі з /allow.
# Порожньо → ADMIN_USER_IDS → ALLOWED_USER_IDS (.env).
COMPUTER_OWNER_USER_IDS=123456789
# Admin PowerShell (elevated). Потребує також HOSTAGENT_ALLOW_ADMIN=1 на хості.
COMPUTER_ALLOW_ADMIN=false
# Підтвердження мутуючих дій (fs_write, CLI, mutating PS) через inline ✅/❌ у Telegram.
COMPUTER_REQUIRE_CONFIRM=true
# Після ✅ автоматично додати cmdlet/exe у data/computer_learned.json; повтор — без ✅.
COMPUTER_AUTO_LEARN_WHITELIST=true
COMPUTER_AUTO_TRUST_LEARNED=true
HOSTAGENT_URL=http://host.docker.internal:8400
# Той самий токен, що й HOSTAGENT_TOKEN для процесу hostagent на Windows-хості.
HOSTAGENT_TOKEN=
# Whitelist перших токенів PowerShell-команд і exe (через кому, lowercase). Порожньо = блокуємо.
PS_WHITELIST=Get-ChildItem,Get-Content,Set-Content,Test-Path,Write-Output,Get-Service,Stop-Service,Start-Service,Restart-Service,Get-Process,docker
CLI_WHITELIST=git,curl,winget,ffmpeg,gh,docker,python
# Більше ітерацій тул-лупа в AGENT_MODE=computer (багатокрокові задачі на хості).
COMPUTER_MAX_ITERS=12
# Smart screen: screenshot → vision одним ланцюжком (/see).
COMPUTER_AUTO_VISION=true
# C3 Browser (Playwright у tools-контейнері). pip install playwright && playwright install chromium
ENABLE_BROWSER=false
# Мутуючі computer-дії на user_id за годину (0 = без ліміту).
COMPUTER_RATE_LIMIT_PER_HOUR=120
# Power actions на хості (lock/sleep/restart). Потребує HOSTAGENT_ALLOW_POWER=1.
COMPUTER_ALLOW_POWER=false
# Drop zone: дефолт шлях на хості для файлів з Telegram (caption «на диск:»).
HOSTAGENT_DROP_DIR=C:\Users\you\Downloads\JARVIS
# Twin: мінімальний eval_score для promote LoRA (0 = без перевірки).
TWIN_MIN_EVAL_PROMOTE=0
# LoRA → Ollama live deploy (Phase 3.2): symlink active + ollama create після promote/rollback.
LORA_DEPLOY_ENABLED=true
# Базова модель у Modelfile; порожньо = OLLAMA_MODEL_AGENT.
LORA_BASE_MODEL=
# Префікс тега Ollama: створюється jarvis-lora:{version}.
LORA_OLLAMA_MODEL=jarvis-lora
# Junction/symlink активного адаптера; порожньо = {DATA_DIR}/twin/lora/active.
LORA_ACTIVE_DIR=

# Cursor IDE tasks — Telegram /cursor + tool cursor_task + Computer Use CLI
CURSOR_TASKS_ENABLED=true
# local = host script (O:\JARVIS) | cloud = Cursor Cloud Agents API
CURSOR_RUNTIME=local
CURSOR_API_KEY=
CURSOR_HOST_WORKSPACE=O:\JARVIS
CURSOR_HOST_SCRIPT=O:\JARVIS\scripts\cursor_run_task.py
CURSOR_PYTHON_EXE=python
CURSOR_MODEL=composer-2.5
# Cloud mode (optional): GitHub repo URL
CURSOR_REPO_URL=
CURSOR_REPO_REF=main
CURSOR_AUTO_CREATE_PR=false
CURSOR_TIMEOUT=900
# Continue.dev — tool continue_dev у Computer Use mode (VS Code + локальний agent API).
# Потребує ENABLE_COMPUTER_USE=true. API: cn serve (POST /message, GET /state).
# За замовчуванням порт 65432; для cn serve: `cn serve --port 65432` або зміни URL.
ENABLE_CONTINUE_DEV=false
CONTINUE_DEV_URL=http://host.docker.internal:65432
CONTINUE_DEV_TIMEOUT=3600
CONTINUE_VSCODE_CLI=code
# Локальна Ollama (рекомендовано): setup_continue.ps1 пише ~/.continue/config.yaml
# з OLLAMA_MODEL_AGENT — CONTINUE_API_KEY не потрібен.
# Опційно (хмарний Continue Hub): ключ з https://continue.dev → Settings → API Keys
CONTINUE_API_KEY=
# Рідні coding-агент інструменти (Стовп B / CODING_AGENT_ROADMAP CA-1.x/2.x):
# read-only: repo_tree, repo_grep, code_read (repo-інтелект поверх host-agent FS);
# мутуючий: code_edit (search_replace/diff, показ diff → confirm, .jarvis_backup перед записом).
# Потребує ENABLE_COMPUTER_USE=true + owner gate (той самий кордон, що run_cli/fs_read).
# Залежності на хості: ripgrep (rg). repo_* за дефолтом пропускають .git/hidden/.gitignore.
ENABLE_CODING_TOOLS=false
CODING_TREE_MAX_ENTRIES=300
CODING_GREP_MAX_RESULTS=60
# D.4: алерт retrain після +N кураційних turns з останнього export (0 = вимкнено).
TRAIN_RETRAIN_MIN_CURATED=200
# Phase 7.1 Orchestrator + Critic
ORCHESTRATOR_ENABLED=true
ORCHESTRATOR_WORKER_BUDGET=5
ORCHESTRATOR_MAX_REVISIONS=1
# Phase 7.2 Self-improving loop (judge → human gate)
SELF_IMPROVE_ENABLED=true
SELF_IMPROVE_SCAN_LIMIT=50
# Health watchdog: алерти в Telegram (сек). 0 = вимкнено.
HEALTH_WATCH_INTERVAL=300
# Порожньо = COMPUTER_OWNER_USER_IDS
HEALTH_ALERT_USER_IDS=
# Голосова відповідь на голосові повідомлення (XTTS v2 GPU). Потребує сервісу tts + NVIDIA GPU.
ENABLE_VOICE_REPLY=false
# --- TTS (сервіс tts/, Coqui XTTS v2) ---
# TTS_DEVICE=cuda          # cuda | cpu | auto
# TTS_LANGUAGE=ru          # uk немає в XTTS; uk reference + ru ≈ найкраща українська
# TTS_SPEAKER_WAV=/app/voices/reference.wav
# TTS_MAX_CHARS=800
# TTS_SYNTH_TIMEOUT=120
# Відповідати на реакції (emoji) користувача до повідомлень бота короткою реплікою.
ENABLE_REACTION_REPLIES=true
# Скільки секунд збирати альбом (media_group), перш ніж обробити його як один запит.
ALBUM_COLLECT_SECONDS=2.0
# Стрім відповіді в Telegram (editMessageText «друкує» текст наживо, як ChatGPT).
# false → одне фінальне повідомлення. На збій стріму — авто-фолбек на класику.
ENABLE_STREAMING=true
# Режим computer лише для ADMIN_USER_IDS (false = усі з whitelist).
COMPUTER_MODE_ADMINS_ONLY=false
# Інтервал доставки нагадувань (сек).
REMINDER_POLL_SECONDS=20
# Не перезапускати агента на edited_message.
IGNORE_EDITED_MESSAGES=true

# --- Telegram Mini App (веб-дашборд) ---
# Публічний HTTPS-URL дашборда (Telegram відкриває Mini App лише по https).
# Напр. named cloudflare tunnel: https://jarvis.example.com/app
# Порожньо = кнопку-меню не реєструємо; апп доступний у браузері на http://localhost:8000/app.
# Достатньо https://домен — суфікс /app додається автоматично.
PUBLIC_APP_URL=
# Локальний URL для підказки /app у браузері (коли немає HTTPS-тунелю).
GATEWAY_BROWSER_URL=http://127.0.0.1:8000
# Admin Mini App (Telegram web_app). Порожньо → PUBLIC_APP_URL з /app на /admin.
# PUBLIC_ADMIN_APP_URL=https://jarvis.example.com/admin
# Пускати /app без Telegram initData (для перегляду в браузері). У проді → false.
WEBAPP_DEV_OPEN=true
# Quick tunnel (*.trycloudflare.com) без домену — autostart/watchdog синхронізує PUBLIC_APP_URL.
# Скрипт: scripts/setup_quick_tunnel.ps1  |  compose: --profile quick-tunnel
ENABLE_QUICK_TUNNEL=false

# --- Admin Control Panel (веб, /admin) ---
# HTTP Basic Auth. Порожній пароль = панель вимкнена (503).
# Локально: http://localhost:8000/admin
# ADMIN_PANEL_USER=admin
# ADMIN_PANEL_PASSWORD=changeme

# --- JARVIS Platform (веб-консоль, /platform) ---
# Self-hosted штаб: Overview, Workbench (SSE), Памʼять, Логи, Налаштування,
# Доступ, Моделі. Логін браузером — HTTP Basic (user = ADMIN_PANEL_USER).
# Порожньо → fallback на ADMIN_PANEL_PASSWORD. Telegram-адміни заходять без пароля.
# Локально: http://localhost:8000/platform
# PLATFORM_PASSWORD=changeme
# Cloudflared named-tunnel токен (Cloudflare Zero Trust → Tunnels). Дає стабільний
# HTTPS-домен для Mini App. Запуск: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# --- Внутрішні URL сервісів (docker-мережа jarvis-net) ---
TOOLS_URL=http://tools:8200
# Для admin-панелі: перевірка health Memory
MEMORY_URL=http://memory:8100
TWIN_URL=http://twin:8765
# Gateway читає TWIN_URL для дашборду /sync у Telegram
WHISPER_URL=http://whisper:9000
TTS_URL=http://tts:8300
GATEWAY_URL=http://gateway:8000

# --- Twin SyncServer (Edge ingest + ModelRegistry) ---
TWIN_DATA_DIR=/data/twin
TWIN_REGISTRY_DB=/data/twin/registry.db
# LLM_BACKEND=ollama|kobold (адаптер §5.2; kobold = KoboldCPP на Edge)
# LLM_BACKEND=ollama
# KOBOLD_HOST=http://host.docker.internal:5001

# --- n8n (LEGACY, лише з docker compose --profile legacy) ---
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=changeme

# --- Часовий пояс ---
GENERIC_TIMEZONE=Europe/Kyiv
TZ=Europe/Kyiv

# --- Host-agent (лише процес на Windows-хості, не в Docker) ---
# Згенеруй: python -c "import secrets;print(secrets.token_hex(24))"
# HOSTAGENT_TOKEN=
# Elevated PowerShell на хості (1 = увімкнено; PowerShell Panel очікує admin).
HOSTAGENT_ALLOW_ADMIN=1
# HOSTAGENT_BIND_HOST=127.0.0.1
# HOSTAGENT_PORT=8400
# FS allowlist (comma paths). Порожньо = без обмеження кореня (не рекомендовано).
# HOSTAGENT_FS_ROOTS=C:\Users\You,O:\JARVIS\data

# --- Platform P5 MCP Gateway (allowlist JSON array) ---
# MCP_SERVERS_JSON=[{"name":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/data"]}]

# --- Platform P6 Connectors (integration tokens) ---
# NOTION_TOKEN=
# NOTION_DATABASE_ID=
# SLACK_BOT_TOKEN=
# SLACK_DEFAULT_CHANNEL=
# CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics

# --- Platform P11 OpenAI-compatible API (opt-in) ---
# ENABLE_OPENAI_API=false
# OPENAI_API_KEY=sk-your-secret-key
# OPENAI_DEFAULT_USER_ID=1112730050
