# Секрети
.env
setup.local.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Кеші інструментів (mypy/pytest)
.mypy_cache/
.pytest_cache/

# Дані рантайму (НЕ комітимо — це приватні дані користувача)
data/uploads/*
!data/uploads/.gitkeep
data/notes/
data/logs/
data/access/
data/twin/
# Рантайм-артефакти: вивчений PS-whitelist і ефемерний URL quick-тунелю.
data/computer_learned.json
data/quick_tunnel.last_url
# ai_tester: recordings містять (зредаговані) тіла відповідей — не для git-дерева; run-звіти = метадані, теж рантайм
data/artifacts/ai_tester/
vendor/sd-forge/

# Логи / тимчасові
*.log
.DS_Store

# Рантайм-артефакти: тест-аудіо TTS, game-mode стейт, бекапи .env
data/*.ogg
data/game_mode.state.json
data/gm_status.txt
.env.bak*
# code_edit git-safety backups (CA-1.3) — створюються host-agent поряд із файлом
.jarvis_backup/

# kaizen (self-improve): ефемерний стан лупа — регенерується щопрогону, не комітимо.
# passports/, summary.json, дайджести лишаються трекабельними (durable felt-evidence).
data/artifacts/self-improve/resume.json
data/artifacts/self-improve/window.json
data/artifacts/self-improve/signatures.json
data/artifacts/self-improve/runs/**/run.jsonl
# R5 «Тонкий шлюз»: retention — старі паспорти пакуються в архів поза git
# (scripts/passport_retention.py, keep-50); історія лишається в git-історії й tar-ах.
data/artifacts/self-improve/archive/

# build-артефакти (APK тощо) — не сорс, не комітимо.
data/artifacts/*.apk
data/artifacts/*.apk.meta.json
