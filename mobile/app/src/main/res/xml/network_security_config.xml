<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted JARVIS часто на LAN по http (без HTTPS-домену) — дозволяємо
     cleartext. Для tunnel/https працює як зазвичай. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
